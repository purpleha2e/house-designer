        vec3 before = hdLocalRadiance(true, p, n, viewDir, material);
        vec3 after = hdLocalRadiance(false, p, n, viewDir, material);
        gl_FragColor = vec4(max(base + after - before + hdSunRadiance(p, n, viewDir, material), vec3(0.0)), 1.0);
      }